{
  "name": "@thornfe/jiramark",
  "description": "JIRA wiki markup to HTML with synchronous and worker-based APIs",
  "version": "1.0.0",
  "author": "Thorn Wu",
  "keywords": [
    "jira"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thornfe/jiramark.git"
  },
  "bugs": {
    "url": "https://github.com/thornfe/jiramark/issues"
  },
  "main": "lib/index.js",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "prepack": "pnpm run build",
    "build:watch": "tsc -p tsconfig.json --watch"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/",
    "bin/",
    "LICENSE",
    "README.md",
    "NOTICE.md"
  ],
  "bin": {
    "jira2html": "bin/jira2html"
  },
  "packageManager": "pnpm@10.23.0",
  "types": "lib/index.d.ts",
  "type": "commonjs"
}
